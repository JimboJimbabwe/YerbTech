              "flag": "-i / --input",
              "path": "outputs/test_outputs/report.txt",
              "required": true,
              "description": "from HSTS_test.py",
              "takes_value": true
            }
          ],
          "outputs": [
            {
              "tag": "MD_OUTPUT",
              "flag": "-o / --output",
              "path": "outputs/test_outputs/HSTS_findings.md",
              "description": "severity ratings + remediation guidance",
              "flag_required": true
            }
          ]
        }
      }
    }
  },
  "06_Session_Management": {
    "WSTG-SESS-01": {
      "Python_Scripts": {
        "script_1": {
          "name": "sess01_m0_pull_cookies.py",
          "path": "WSTG-SESS-01/utilities/python/sess01_m0_pull_cookies.py",
          "run_order": 1,
          "depends_on": [],
          "step_label": "Module 0",
          "description": "Parses a single-user Burp Suite XML export and extracts all cookie names and values from every request and response.",
          "command": "python3 WSTG-SESS-01/utilities/python/sess01_m0_pull_cookies.py --xml WSTG-SESS-01/inputs/xml/session_walk.xml",
          "inputs": [
            {
              "tag": "XML_INPUT",
              "flag": "--xml",
              "path": "WSTG-SESS-01/inputs/xml/session_walk.xml",
              "required": true,
              "takes_value": true
            }
          ],
          "outputs": [
            {
              "tag": "WORDLIST_OUTPUT",
              "path": "WSTG-SESS-01/outputs/cookies_raw.txt",
              "description": "NAME=VALUE per line; consumed by script_4 (m3) for overlap detection"
            },
            {
              "tag": "JSON_OUTPUT",
              "path": "WSTG-SESS-01/outputs/cookies_by_name.json",
              "description": "{name: [value, value, ...]}; consumed by script_3 (m2)"
            },
            {
              "tag": "JSON_OUTPUT",
              "path": "WSTG-SESS-01/outputs/cookies_dataset.json",
              "description": "[{request_index, url, name, value}, ...]. Docstring claims this 'feeds Modules 1-3', but only m2/m3 have a confirmed consumption path -- see fragment _meta notes."
            }
          ]
        },
        "script_2": {
          "name": "sess01_m1_string_seeker.py",
          "path": "WSTG-SESS-01/utilities/python/sess01_m1_string_seeker.py",
          "run_order": 2,
          "depends_on": [],
          "docstring_conflict": "m0's docstring claims its dataset JSON feeds this module, but this module's own Usage block only takes --xml, with no flag consuming m0's output. See fragment _meta notes.",
          "step_label": "Module 1",
          "description": "Examines every Set-Cookie directive and request/response header across the full XML walk to surface cookie security misconfigurations.",
          "command": "python3 WSTG-SESS-01/utilities/python/sess01_m1_string_seeker.py --xml WSTG-SESS-01/inputs/xml/session_walk.xml",
          "inputs": [
            {
              "tag": "XML_INPUT",
              "flag": "--xml",
              "path": "WSTG-SESS-01/inputs/xml/session_walk.xml",
              "required": true,
              "takes_value": true
            }
          ],
          "outputs": [
            {
              "tag": "JSON_OUTPUT",
              "path": "WSTG-SESS-01/outputs/m1_findings.json"
            },
            {
              "tag": "TXT_OUTPUT",
              "path": "WSTG-SESS-01/outputs/m1_report.txt",
              "description": "human-readable"
            }
          ],
          "checks": [
            "1. all Set-Cookie headers tagged Secure?",
            "2. any cookie operations over HTTP (unencrypted)?",
            "3. can a cookie be forced over HTTP? (HTTP endpoint exists for same host)",
            "4. any cookies Persistent? (Expires or Max-Age)",
            "5. is expiry reasonable? (>24h flagged long-lived)",
            "6. HTTP/1.1 Cache-Control directives present? (no-store, no-cache, must-revalidate)",
            "7. HTTP/1.0 Pragma: no-cache present?",
            "8. HttpOnly flag present on session cookies?",
            "9. SameSite attribute present and Strict or Lax?"
          ]
        },
        "script_3": {
          "name": "sess01_m2_cookie_analyzer.py",
          "path": "WSTG-SESS-01/utilities/python/sess01_m2_cookie_analyzer.py",
          "run_order": 3,
          "depends_on": [
            "script_1 (sess01_m0_pull_cookies.py -> cookies_by_name.json)"
          ],
          "step_label": "Module 2",
          "description": "Reads cookies_by_name.json and performs sequential pattern analysis on each cookie's ordered value history: for each cookie with >=2 observed values, slides windows of size 2-5 across each value, tries parsing as decimal integers, and flags a position as sequential if >=2 consecutive values parse with a constant numeric step. A 'Break' alert logs observation indices when >=2 sequential windows recur at the same position across consecutive cookies.",
          "why_it_matters": "Sequential session tokens indicate predictable server-side token generation; an attacker who observes their own token can compute adjacent tokens for other active sessions. Reference: OWASP WSTG-SESS-01 section Token Analysis.",
          "command": "python3 WSTG-SESS-01/utilities/python/sess01_m2_cookie_analyzer.py --cookies WSTG-SESS-01/outputs/cookies_by_name.json",
          "inputs": [
            {
              "tag": "JSON_INPUT",
              "flag": "--cookies",
              "path": "WSTG-SESS-01/outputs/cookies_by_name.json",
              "required": true,
              "description": "from sess01_m0_pull_cookies.py",
              "takes_value": true
            }
          ],
          "outputs": [
            {
              "tag": "JSON_OUTPUT",
              "path": "WSTG-SESS-01/outputs/m2_analysis.json"
            },
            {
              "tag": "TXT_OUTPUT",
              "path": "WSTG-SESS-01/outputs/m2_alerts.txt"
            }
          ]
        },
        "script_4": {
          "name": "sess01_m3_reverse_engineer.py",
          "path": "WSTG-SESS-01/utilities/python/sess01_m3_reverse_engineer.py",
          "run_order": 4,
          "depends_on": [
            "script_1 (sess01_m0_pull_cookies.py -> cookies_raw.txt, used for overlap detection; not a CLI flag, by description only)",
            "self (WSTG-SESS-01/inputs/json/static_items.json persisted by this script's own prior runs -- read back unless --reset)"
          ],
          "step_label": "Module 3",
          "description": "Black-box cookie reverse engineering. Combines static items (credentials, auto-detected IP, run-time timestamp, user-agent) with items auto-extracted from the XML (domain, headers, body values, path segments, endpoint names). Generates all non-empty subsets of the combined item pool, concatenates with common separators, encodes/hashes each combo with every supported algorithm, then checks for overlap against actual cookie values from cookies_raw.txt.",
          "persistence": "static_items.json is written on first run and read back on subsequent runs without --username/--password; --reset forces re-collection.",
          "command": "python3 WSTG-SESS-01/utilities/python/sess01_m3_reverse_engineer.py --xml WSTG-SESS-01/inputs/xml/session_walk.xml [--username jsmith --password hunter2] [--ip <override>] [--ua <0-11>] [--reset]",
          "run_variants": [
            {
              "description": "first run -- supply credentials, auto-detect IP/timestamp/UA",
              "example": "--xml ... --username jsmith --password hunter2"
            },
            {
              "description": "subsequent runs -- reads stored static_items.json, credential flags optional",
              "example": "--xml ..."
            },
            {
              "description": "reset stored items and re-supply",
              "example": "--xml ... --username jsmith --password hunter2 --reset"
            },
            {
              "description": "pick a specific user-agent index instead of all",
              "example": "--ua 3"
            }
          ],
          "inputs": [
            {
              "tag": "XML_INPUT",
              "flag": "--xml",
              "required": true,
              "takes_value": true
            },
            {
              "tag": "OPTION_INPUT",
              "flag": "--username",
              "required": false,
              "description": "required on first run unless static_items.json already exists",
              "takes_value": true
            },
            {
              "tag": "OPTION_INPUT",
              "flag": "--password",
              "required": false,
              "description": "same condition as --username",
              "takes_value": true
            },
            {
              "tag": "OPTION_INPUT",
              "flag": "--ip",
              "required": false,
