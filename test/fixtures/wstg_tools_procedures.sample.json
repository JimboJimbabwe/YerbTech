{
  "_meta": {
    "note": "trimmed sample of wstg_tools_procedures.json for tests; WSTG-INJT-04 is synthetic"
  },
  "01_Information_Gathering": {
    "WSTG-INFO-02": {
      "Python_Scripts": {
        "script_1": {
          "name": "info2_orchestrator.py",
          "path": "WSTG_Repository/01_Information_Gathering/WSTG-INFO-02/Utilities/python/info2_orchestrator.py",
          "run_order": 1,
          "depends_on": [],
          "command": "python info2_orchestrator.py --file <burp_export.xml> [--webserverenum <path/to/WebserverEnum.py>] [--base <repo_base_path>] [--no-wait]",
          "inputs": [
            {
              "tag": "XML_INPUT",
              "flag": "--file",
              "description": "Burp XML export; target URL(s) parsed from it",
              "required": true,
              "takes_value": true
            },
            {
              "tag": "OPTION_INPUT",
              "flag": "--webserverenum",
              "description": "path to WebserverEnum.py",
              "required": false,
              "takes_value": true
            },
            {
              "tag": "OPTION_INPUT",
              "flag": "--base",
              "required": false,
              "takes_value": true
            },
            {
              "tag": "OPTION_INPUT",
              "flag": "--no-wait",
              "description": "skips the 2 minute pause",
              "required": false,
              "takes_value": false
            }
          ],
          "outputs": [
            {
              "tag": "MD_OUTPUT",
              "path": "Utilities/Kali_Tools/curl/<timestamp>.md",
              "condition": "single domain (curl -I)"
            },
            {
              "tag": "MD_OUTPUT",
              "path": "Utilities/Kali_Tools/httpx/<timestamp>.md",
              "condition": "multiple domains (httpx)"
            },
            {
              "tag": "MD_OUTPUT",
              "path": "Utilities/Kali_Tools/whatweb/<timestamp>.md"
            },
            {
              "tag": "MD_OUTPUT",
              "path": "Outputs/test_outputs/findings.md"
            }
          ],
          "internal_steps": [
            "1. parse target URL(s) from Burp XML",
            "2. curl -I (single domain) OR httpx (multiple domains)",
            "3. wait 2 minutes",
            "4. whatweb against each target",
            "5. run WebserverEnum.py (Burp XML version scanner)"
          ]
        }
      }
    }
  },
  "02_Configuration_and_Deployment_Management": {
    "WSTG-CONF-02": {
      "Python_Scripts": {
        "script_1": {
          "name": "conf_02_wordlist.py",
          "path": "WSTG-CONF-02/utilities/python/conf_02_wordlist.py",
          "run_order": 1,
          "depends_on": [],
          "command": "python3 WSTG-CONF-02/utilities/python/conf_02_wordlist.py [--repo WSTG-CONF-02/inputs/json/svc_repo.json]",
          "inputs": [
            {
              "tag": "JSON_INPUT",
              "flag": "--repo",
              "path": "WSTG-CONF-02/inputs/json/svc_repo.json",
              "required": false,
              "description": "secondary service repo; without it, source 2 (svc_repo paths) is skipped",
              "takes_value": true
            }
          ],
          "outputs": [
            {
              "tag": "WORDLIST_OUTPUT",
              "path": "WSTG-CONF-02/inputs/wordlist/conf_02_paths.txt",
              "description": "flat Burp-ready list"
            },
            {
              "tag": "JSON_OUTPUT",
              "path": "WSTG-CONF-02/inputs/json/conf_02_paths.json",
              "description": "categorised JSON: debug/dotslash/config/default/svc_repo/backup_variants"
            }
          ],
          "sources": [
            "1. hardcoded base lists (debug, dotslash, config, default)",
            "2. svc_repo.json -> Ports[] -> PotentialServices[] -> DefaultEndpoints+CommonEndpoints+UndesirableEndpoints (category svc_repo)",
            "3. primary service repo -- MISSING LOGIC stub, returns [] with warning",
            "4. OBJ1/OBJ2 backup-variant suffix generation over all of the above (category backup_variants)"
          ]
        },
        "script_2": {
          "name": "conf02_enum.py",
          "path": "WSTG_Repository/02_Configuration_and_Deployment_Management/WSTG-CONF-02/Utilities/python/conf02_enum.py",
          "run_order": 2,
          "depends_on": [],
          "inferred": true,
          "order_note": "No CLI usage block was in the docstring, so flags/paths are unknown. Ordered independently of conf_02_wordlist.py -- different enumeration source (Burp XML + services JSON, not svc_repo.json).",
          "command": null,
          "inputs": [
            {
              "tag": "XML_INPUT",
              "description": "Burp Suite XML export",
              "flag": null,
              "required": true
            },
            {
              "tag": "JSON_INPUT",
              "description": "services JSON (detected-services map)",
              "flag": null,
              "required": true
            }
          ],
          "outputs": [
            {
              "tag": "WORDLIST_OUTPUT",
              "path": null,
              "description": "targeted wordlist, capped at 15 CommonEndpoints + 15 UndesirableEndpoints per matched service"
            }
          ]
        },
        "script_3": {
          "name": "svc_dsr.py",
          "path": "WSTG_Repository/02_Configuration_and_Deployment_Management/WSTG-CONF-02/Utilities/python/svc_dsr.py",
          "run_order": 3,
          "depends_on": [],
          "inferred": true,
          "order_note": "Independent shared utility ('Service Disseminator'); WSTG-CONF-05/conf_05_wordlist.py reuses this same trigger/extractor logic for its 'paths' category.",
          "command": "python3 svc_dsr.py --init | python3 svc_dsr.py --type <category> | python3 svc_dsr.py --all",
          "modes": [
            {
              "flag": "--init",
              "description": "create SVC_DSR/ folder structure + default input.txt files"
            },
            {
              "flag": "--type",
              "values": [
                "env_vars",
                "paths",
                "headers",
                "default_creds",
                "commands"
              ],
              "description": "run one category"
            },
            {
              "flag": "--all",
              "description": "run all five categories sequentially (also runs --init first)"
            }
          ],
          "inputs": [
            {
              "tag": "JSON_INPUT",
              "flag": "--bridge",
              "path": "how_to_steps_bridge.json",
              "required": false,
              "default": true,
              "takes_value": true
            },
            {
              "tag": "JSON_INPUT",
              "flag": "--main",
              "path": "conceptual_mapping_v4_complete.json",
              "required": false,
              "default": true,
              "takes_value": true
            },
            {
              "tag": "WORDLIST_INPUT",
              "path": "SVC_DSR/<Folder>/input.txt",
              "description": "one trigger per line; plain string = substring match (case-insensitive); 'regex:' prefix = raw regex; '#' = comment",
              "required": false
            }
          ],
          "outputs": [
            {
              "tag": "JSON_OUTPUT",
              "path": "SVC_DSR/<Folder>/output.json",
              "description": "{ query_type, matched_items, LIST, References }",
              "per_category": true
            },
            {
              "tag": "WORDLIST_OUTPUT",
              "path": "SVC_DSR/<Folder>/wordlist.txt",
              "description": "flat newline-separated extracted values, Burp-ready",
              "per_category": true
            },
            {
              "tag": "TXT_OUTPUT",
              "path": "SVC_DSR/<Folder>/output.txt",
              "description": "backward-compat duplicate of output.json",
              "per_category": true
            }
          ]
        },
        "script_4": {
          "name": "conf_02_verdict.py",
          "path": "WSTG-CONF-02/utilities/python/conf_02_verdict.py",
          "run_order": 4,
          "depends_on": [
            "script_1 (conf_02_wordlist.py -> conf_02_paths.json, optional)",
            "manual: wordlist loaded into Burp Intruder to produce intruder_conf02.xml"
          ],
          "command": "python3 WSTG-CONF-02/utilities/python/conf_02_verdict.py --intruder WSTG-CONF-02/inputs/xml/intruder_conf02.xml [--paths-json WSTG-CONF-02/inputs/json/conf_02_paths.json] [--min-bytes 500] [--target https://app.example.com]",
          "inputs": [
            {
              "tag": "XML_INPUT",
              "flag": "--intruder",
              "path": "WSTG-CONF-02/inputs/xml/intruder_conf02.xml",
              "required": true,
              "description": "Burp Intruder or proxy XML export",
              "takes_value": true
            },
            {
              "tag": "JSON_INPUT",
              "flag": "--paths-json",
              "path": "WSTG-CONF-02/inputs/json/conf_02_paths.json",
              "required": false,
              "description": "category map for payload->category reverse lookup; if absent all payloads are 'unknown'",
              "takes_value": true
            },
            {
              "tag": "OPTION_INPUT",
              "flag": "--min-bytes",
              "default": 500,
              "required": false,
              "takes_value": true
            },
            {
              "tag": "OPTION_INPUT",
              "flag": "--target",
              "required": false,
              "takes_value": true
            }
          ],
          "outputs": [
            {
              "tag": "MD_OUTPUT",
              "path": "WSTG-CONF-02/outputs/test_outputs/sitrep.md",
              "description": "appended, not overwritten"
            },
            {
              "tag": "JSON_OUTPUT",
              "path": "WSTG-CONF-02/inputs/json/intruder_alerts.json"
            }
          ],
          "alert_logic": {
            "200": "HIGH",
            "404": "SKIP",
            "302/202/301": "MEDIUM",
            "403/500 >= --min-bytes": "LOW (verbose error, interesting)",
            "403/500 < --min-bytes": "SKIP (bare error, noise)",
            "other": "SKIP",
            "body_signals": [
              "INDEXING (Index of, Parent Directory, mod_autoindex, etc.)",
              "SENSITIVE_CONTENT (DB_HOST, password=, API_KEY, secret=, etc.)"
            ]
          }
        }
      }
    },
    "WSTG-CONF-06": {
      "Python_Scripts": {
        "script_1": {
          "name": "methods_gen.py",
          "path": "WSTG-CONF-06/utilities/python/methods_gen.py",
          "run_order": 1,
          "depends_on": [],
          "step_label": "Step 1 of 3",
          "command": "python3 methods_gen.py --xml-file inputs/xml/export.xml [-o inputs/wordlists/curl_urls.txt] [--methods-out inputs/wordlists/methods.txt]",
          "inputs": [
            {
              "tag": "XML_INPUT",
              "flag": "--xml-file",
              "required": true,
              "description": "Burp Suite XML export (sitemap)",
              "takes_value": true
            }
          ],
          "outputs": [
            {
              "tag": "WORDLIST_OUTPUT",
              "flag": "-o / --output",
              "path": "inputs/wordlists/curl_urls.txt",
              "description": "curl target URL list, default path shown",
              "flag_required": false
            },
            {
              "tag": "WORDLIST_OUTPUT",
              "flag": "--methods-out",
              "path": "inputs/wordlists/methods.txt",
              "description": "safe methods only: OPTIONS, TRACE, HEAD, CONNECT -- never PUT/DELETE/PATCH",
              "flag_required": false
            }
          ]
        },
        "script_2": {
          "name": "methods_test.py",
          "path": "WSTG-CONF-06/utilities/python/methods_test.py",
          "run_order": 2,
          "depends_on": [
            "script_1 (methods_gen.py -> curl_urls.txt, methods.txt)"
          ],
          "step_label": "Step 2 of 3",
          "safety_constraint": "Refuses to run PUT, DELETE, or PATCH -- those write operations must be tested manually with explicit intent.",
          "command": "python3 methods_test.py --url-list inputs/wordlists/curl_urls.txt --methods inputs/wordlists/methods.txt -o outputs/test_outputs/WSTG-CONF-06/methods_outcome.md",
          "inputs": [
            {
              "tag": "WORDLIST_INPUT",
              "flag": "--url-list",
              "required": true,
              "description": "from methods_gen.py",
              "takes_value": true
            },
            {
              "tag": "WORDLIST_INPUT",
              "flag": "--methods",
              "required": true,
              "description": "from methods_gen.py",
              "takes_value": true
            },
            {
              "tag": "OPTION_INPUT",
              "flag": "--timeout",
              "default": 10,
              "required": false,
              "takes_value": true
            },
            {
              "tag": "OPTION_INPUT",
              "flag": "--concurrency",
              "default": 5,
              "required": false,
              "takes_value": true
            },
            {
              "tag": "OPTION_INPUT",
              "flag": "--auth-only",
              "required": false,
              "description": "only test URLs containing auth path keywords",
              "takes_value": false
            }
          ],
          "outputs": [
            {
              "tag": "MD_OUTPUT",
              "flag": "-o / --output",
              "path": "outputs/test_outputs/WSTG-CONF-06/methods_outcome.md",
              "description": "full response headers + status code per method/URL pair",
              "flag_required": true
            }
          ]
        },
        "script_3": {
          "name": "methods_outcome.py",
          "path": "WSTG-CONF-06/utilities/python/methods_outcome.py",
          "run_order": 3,
          "depends_on": [
            "script_2 (methods_test.py -> methods_outcome.md)"
          ],
          "step_label": "Step 3 of 3",
          "command": "python3 methods_outcome.py -i outputs/test_outputs/WSTG-CONF-06/methods_outcome.md -o outputs/test_outputs/WSTG-CONF-06/methods_findings.md",
          "inputs": [
            {
              "tag": "MD_INPUT",
              "flag": "-i / --input",
              "path": "outputs/test_outputs/WSTG-CONF-06/methods_outcome.md",
              "required": true,
              "description": "from methods_test.py",
              "takes_value": true
            }
          ],
          "outputs": [
            {
              "tag": "MD_OUTPUT",
              "flag": "-o / --output",
              "path": "outputs/test_outputs/WSTG-CONF-06/methods_findings.md",
              "flag_required": true
            }
          ],
          "flags_checked": [
            "dangerous methods advertised in Allow headers (PUT, CONNECT, DELETE, PATCH)",
            "TRACE accepted (XST risk)",
            "methods returning unexpected 2xx on auth pathways",
            "CONNECT accepted (proxy tunnelling)"
          ]
        }
      }
    },
    "WSTG-CONF-07": {
